{% trans_default_domain 'Modules.Dashtrends.Admin' %}

{# PoC for PrestaShop/PrestaShop#41971: canvas + JSON island following the contract
   documented in admin-dev/themes/new-theme/js/libs/dashboardCharts.ts. No module JS needed —
   the core chartjs.bundle.js auto-mounts any canvas[data-chart] on the page. #}
<div class="card">
  <div class="card-header">
    <h3 class="card-header-title">
      <i class="material-icons">show_chart</i>
      {{ 'Sales trend'|trans({}, 'Admin.Global') }}
    </h3>
  </div>
  <div class="card-body">
    <canvas
      id="{{ chartId }}"
      data-chart
      height="140"
      role="img"
      aria-label="{{ 'Sales trend'|trans({}, 'Admin.Global') }}"
    ></canvas>
    <script type="application/json" id="{{ chartId }}-data">{{ chartConfig|raw }}</script>
  </div>
  <div class="card-footer text-muted">
    {{ 'Selected range: %from% → %to%'|trans({'%from%': dateFrom, '%to%': dateTo}) }}
  </div>
</div>
